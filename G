  // listings and login persist across reloads instead of resetting.
  useEffect(() => {
    (async () => {
      try {
        const [bRes, pRes, uRes] = await Promise.all([
          window.storage.get("bookings").catch(() => null),
          window.storage.get("partnerListings").catch(() => null),
          window.storage.get("user").catch(() => null),
        ]);
        if (bRes?.value) {
          const parsed = JSON.parse(bRes.value).map((b) => ({ ...b, bookedAt: new Date(b.bookedAt) }));
          setBookings(parsed);
        }
        if (pRes?.value) {
          const parsed = JSON.parse(pRes.value).map((p) => ({ ...p, submittedAt: new Date(p.submittedAt) }));
          setPartnerListings(parsed);
        }
        if (uRes?.value) setUser(JSON.parse(uRes.value));
      } catch (e) {
        // storage unavailable — app still works, just won't persist
      } finally {
        setHydrated(true);
      }
    })();
  }, []);

