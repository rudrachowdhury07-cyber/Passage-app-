          {NAV_ITEMS.map((n) => {
            const isActive = tab === n.id;
            return (
              <button
                key={n.id}
                onClick={() => setTab(n.id)}
                style={{
                  display: "flex", alignItems: "center", gap: 6,
                  color: isActive ? INK : IVORY_DIM,
                  background: isActive ? `linear-gradient(135deg, ${GOLD_SOFT}, ${GOLD})` : "transparent",
                  border: "none", cursor: "pointer", padding: isActive ? "8px 14px" : "8px 10px",
                  borderRadius: 22, transition: "all .18s ease",
                }}
              >
                <n.icon size={16} />
                {isActive && <span style={{ fontSize: 11, fontFamily: FONT_BODY, fontWeight: 700, whiteSpace: "nowrap" }}>{n.label}</span>}
              </button>
            );
          })}
        </div>
      
