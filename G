/* ============================================================
   SEEDED MOCK ANALYTICS
   Deterministic per business (seeded off its ref), so numbers
   stay stable across re-renders instead of jittering randomly.
   ============================================================ */

function seededRand(seed) {
  let h = 0;
  for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) >>> 0;
  return () => {
    h = (h * 1664525 + 1013904223) >>> 0;
    return h / 4294967296;
  };
}

const DOW = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const STATUSES = ["Confirmed", "Confirmed", "Confirmed", "Checked in", "Cancelled"];
const GUEST_NAMES = [
  "A. Kensington", "M. Dubois", "S. Almeida", "R. Okafor", "L. Tanaka",
  "J. Petrov", "F. Novak", "C. Silva", "N. Haddad", "T. Ibrahim",
  "E. Larsson", "P. Wickramasinghe",
];

const TIER_NAMES_BY_CATEGORY = {
  hotel: ["Standard Room", "Suite", "Villa"],
  restaurant: ["Walk-in Table", "Reserved Table", "Chef's Table"],
  concert: ["General", "Floor", "VIP"],
  cinema: ["Standard", "Premium", "Recliner"],
  flight: ["Economy", "Business", "First"],
  train: ["Standard", "Green Car", "Sleeper"],
  bus: ["Standard", "Gold Class", "VIP"],
  ship: ["Interior", "Balcony", "Suite"],
  club: ["Entry", "Table", "VIP Table"],
};

function defaultPrices(seed, categoryId) {
  const rand = seededRand(seed);
  const base = 60 + Math.floor(rand() * 260);
  const tiers = TIER_NAMES_BY_CATEGORY[categoryId] || ["Standard", "Premium", "VIP"];
  const out = {};
  tiers.forEach((name, i) => {
    out[name] = Math.round(base * (1 + i * 0.7));
  });
  return out;
}

function buildAnalytics(listing) {
  const rand = seededRand(listing.ref);
  const cat = CATEGORIES.find((c) => c.id === listing.category) || CATEGORIES[0];
  const tierNames = TIER_NAMES_BY_CATEGORY[listing.category] || ["Standard", "Premium", "VIP"];
  const prices = listing.prices || defaultPrices(listing.ref, listing.category);
  const basePrice = Math.round(Object.values(prices).reduce((a, b) => a + b, 0) / Object.values(prices).length);

  // 14-day revenue + bookings trend
  const trend = [];
  let bookingTotal = 0;
  let revenueTotal = 0;
  for (let i = 13; i >= 0; i--) {
    const d = new Date();
    d.setDate(d.getDate() - i);
    const bookingsDay = Math.max(0, Math.round(3 + rand() * 9 + Math.sin(i / 2) * 2));
    const revDay = Math.round(bookingsDay * basePrice * (0.85 + rand() * 0.3));
    bookingTotal += bookingsDay;
    revenueTotal += revDay;
    trend.push({
      label: `${DOW[d.getDay() === 0 ? 6 : d.getDay() - 1]} ${d.getDate()}`,
      bookings: bookingsDay,
      revenue: revDay,
    });
  }

  const prevPeriodRevenue = Math.round(revenueTotal * (0.78 + rand() * 0.3));
  const prevPeriodBookings = Math.round(bookingTotal * (0.8 + rand() * 0.3));
  const revenueDelta = ((revenueTotal - prevPeriodRevenue) / prevPeriodRevenue) * 100;
  const bookingsDelta = ((bookingTotal - prevPeriodBookings) / prevPeriodBookings) * 100;
  const avgValue = Math.round(revenueTotal / Math.max(1, bookingTotal));
  const conversion = Math.round(18 + rand() * 22);

  const breakdown = tierNames.map((name, i) => {
    const share = i === 0 ? 0.5 - rand() * 0.1 : i === 1 ? 0.32 + rand() * 0.06 : 0.18 + rand() * 0.05;
    return { name, value: Math.round(bookingTotal * share) };
  });

  // recent bookings feed
  const recent = Array.from({ length: 8 }).map((_, i) => {
    const d = new Date();
    d.setDate(d.getDate() - Math.floor(rand() * 13));
    const tier = tierNames[Math.floor(rand() * tierNames.length)];
    const amount = prices[tier] || basePrice;
    return {
      id: listing.ref + "-" + i,
      guest: GUEST_NAMES[Math.floor(rand() * GUEST_NAMES.length)],
      tier,
      amount,
      status: STATUSES[Math.floor(rand() * STATUSES.length)],
      date: d,
    };
  }).sort((a, b) => b.date - a.date);

  const unpaidShare = 0.12 + rand() * 0.1;
  const grossUnpaid = Math.round(revenueTotal * unpaidShare);
  const rate = listing.commissionRate ?? PLATFORM_COMMISSION_RATE;
  const commission = Math.round(grossUnpaid * rate * 100) / 100;
  const payoutPending = Math.round((grossUnpaid - commission) * 100) / 100;
  const rating = (4.3 + rand() * 0.65).toFixed(1);

  return {
    cat, tierNames, prices, basePrice, trend, bookingTotal, revenueTotal, revenueDelta, bookingsDelta,
    avgValue, conversion, breakdown, recent, payoutPending, grossUnpaid, commission, commissionRate: rate, rating,
  };
}

