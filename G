function fmtMoney(n) {
  return "$" + n.toLocaleString("en-US");
}

function KpiCard({ icon: Icon, label, value, delta, deltaGood = true }) {
  const positive = delta >= 0;
  const good = deltaGood ? positive : !positive;
  return (
    <div style={{ flex: 1, minWidth: 130, border: `1px solid ${LINE}`, borderRadius: 14, padding: "14px 15px", background: "rgba(243,238,226,0.02)" }}>
      <div style={{ display: "flex", alignItems: "center", gap: 6, marginBottom: 10 }}>
        <Icon size={13} color={GOLD} />
        <span style={{ fontSize: 10.5, letterSpacing: "0.06em", textTransform: "uppercase", color: IVORY_DIM }}>{label}</span>
      </div>
      <div style={{ fontFamily: FONT_DISPLAY, fontSize: 24, color: IVORY, fontWeight: 600, marginBottom: 6 }}>{value}</div>
      {delta !== undefined && (
        <div style={{ display: "flex", alignItems: "center", gap: 3, fontSize: 11, fontFamily: FONT_MONO, color: good ? "#8FC9A0" : "#D98E96" }}>
          {positive ? <ArrowUpRight size={11} /> : <ArrowDownRight size={11} />}
          {Math.abs(delta).toFixed(1)}% vs prior 14d
        </div>
      )}
    </div>
  );
}

function DashboardChartCard({ title, children, right }) {
  return (
    <div style={{ border: `1px solid ${LINE}`, borderRadius: 14, padding: "16px 14px 8px", background: "rgba(243,238,226,0.02)", marginBottom: 16 }}>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 6, padding: "0 4px" }}>
        <Eyebrow>{title}</Eyebrow>
        {right}
      </div>
      {children}
    </div>
  );
}

function DashboardTooltip({ active, payload, label, moneyKey }) {
  if (!active || !payload || !payload.length) return null;
  return (
    <div style={{ background: INK, border: `1px solid ${GOLD}`, borderRadius: 8, padding: "8px 10px", fontFamily: FONT_MONO, fontSize: 11 }}>
      <div style={{ color: IVORY_DIM, marginBottom: 3 }}>{label}</div>
      {payload.map((p, i) => (
        <div key={i} style={{ color: GOLD_SOFT }}>
          {p.dataKey === "revenue" ? fmtMoney(p.value) : p.value} {p.dataKey === "revenue" ? "" : p.dataKey}
