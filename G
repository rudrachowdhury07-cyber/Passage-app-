function LoginScreen({ onLoggedIn }) {
  const [mode, setMode] = useState("methods"); // methods | email | phone | loading
  const [email, setEmail] = useState("");
  const [pw, setPw] = useState("");
  const [phone, setPhone] = useState("");
  const [otp, setOtp] = useState("");
  const [otpSent, setOtpSent] = useState(false);
  const [agreed, setAgreed] = useState(false);
  const [showAgreeHint, setShowAgreeHint] = useState(false);

  const finishLogin = (name, via) => {
    setMode("loading");
    setTimeout(() => onLoggedIn({ name, via }), 700);
  };

  const handleMethodClick = (m) => {
    if (!agreed) { setShowAgreeHint(true); return; }
    if (m.id === "email") return setMode("email");
    if (m.id === "phone") return setMode("phone");
    // social / device methods simulate an instant redirect + return
    finishLogin(
      m.id === "google" ? "Rudra (Google)" :
      m.id === "apple" ? "Rudra (Apple ID)" :
      m.id === "facebook" ? "Rudra (Facebook)" :
      m.id === "whatsapp" ? "Rudra (WhatsApp)" :
      m.id === "biometric" ? "Rudra (Face ID)" : "Rudra (Magic Link)",
      m.id
    );
  };

  if (mode === "loading") {
    return (
      <div style={{ display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", padding: "80px 20px" }}>
        <Loader2 size={26} color={GOLD} className="spin" style={{ animation: "spin 0.9s linear infinite" }} />
        <div style={{ color: IVORY_DIM, fontSize: 13, marginTop: 14 }}>Signing you in…</div>
        <style>{`@keyframes spin { to { transform: rotate(360deg); } }`}</style>
      </div>
    );
  }

  return (
    <div style={{ maxWidth: 480, margin: "0 auto", padding: "26px 20px 40px" }}>
      <div
        style={{
          width: 52, height: 52, borderRadius: 14, margin: "0 auto 18px",
          background: "rgba(201,162,75,0.14)", border: `1px solid ${GOLD}`,
          display: "flex", alignItems: "center", justifyContent: "center",
        }}
      >
        <User size={22} color={GOLD} />
      </div>
      <div
        style={{
          fontFamily: FONT_WORDMARK, fontSize: 26, fontWeight: 700,
          letterSpacing: "0.06em", textTransform: "uppercase",
          textAlign: "center", color: IVORY, marginBottom: 6,
        }}
      >
        Passage
      </div>
      <div
        style={{
          fontFamily: FONT_BODY, fontSize: 8, fontWeight: 500,
          letterSpacing: "0.3em", textTransform: "uppercase", color: GOLD_SOFT,
          textAlign: "center", marginBottom: 20,
        }}
      >
        Sign In · Worldwide Collection
      </div>

      {mode === "methods" && (
        <>
          <div
            onClick={() => { setAgreed((a) => !a); setShowAgreeHint(false); }}
            style={{
              display: "flex", alignItems: "flex-start", gap: 10, padding: "11px 12px", marginBottom: 14,
              borderRadius: 10, border: `1px solid ${showAgreeHint ? "#D98E96" : LINE}`,
              background: "rgba(243,238,226,0.03)", cursor: "pointer",
            }}
          >
            <div
              style={{
                width: 17, height: 17, borderRadius: 5, flexShrink: 0, marginTop: 1,
                border: `1.5px solid ${agreed ? GOLD : IVORY_DIM}`, background: agreed ? GOLD : "transparent",
                display: "flex", alignItems: "center", justifyContent: "center",
              }}
            >
              {agreed && <Check size={11} color={INK} />}
            </div>
            <div style={{ fontSize: 11.5, color: IVORY_DIM, lineHeight: 1.5 }}>
              I agree to the <span style={{ color: GOLD_SOFT }}>Terms of Service</span>, <span style={{ color: GOLD_SOFT }}>Privacy Policy</span> and{" "}
              <span style={{ color: GOLD_SOFT }}>Cancellation Policy</span>.
            </div>
          </div>
          {showAgreeHint && (
            <div style={{ display: "flex", alignItems: "center", gap: 6, color: "#D98E96", fontSize: 11, marginBottom: 12 }}>
              <Info size={12} /> Please accept the terms to continue.
            </div>
          )}

          <div style={{ display: "flex", flexDirection: "column", gap: 9, opacity: agreed ? 1 : 0.55 }}>
            {LOGIN_METHODS.map((m) => {
              const MIcon = m.icon;
              return (
                <button
                  key={m.id}
                  onClick={() => handleMethodClick(m)}
                  style={{
                    display: "flex", alignItems: "center", gap: 12, width: "100%",
                    padding: "12px 14px", borderRadius: 12, border: `1px solid ${LINE}`,
                    background: "rgba(243,238,226,0.03)", cursor: "pointer", textAlign: "left",
                  }}
                >
                  <div style={{ width: 32, height: 32, borderRadius: 8, background: "rgba(243,238,226,0.06)", display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0 }}>
                    <MIcon size={15} color={GOLD} />
                  </div>
                  <div style={{ flex: 1 }}>
                    <div style={{ color: IVORY, fontSize: 13, fontWeight: 600 }}>{m.label}</div>
                    {m.desc && <div style={{ color: IVORY_DIM, fontSize: 11 }}>{m.desc}</div>}
                  </div>
                  <ArrowRight size={14} color={IVORY_DIM} />
                </button>
              );
            })}
          </div>
          <div style={{ color: IVORY_DIM, fontSize: 10.5, textAlign: "center", marginTop: 18, lineHeight: 1.5 }}>
            This is a design prototype — no real accounts are created and no data leaves this session's storage.
          </div>
        </>
      )}

      {mode === "email" && (
        <>
          <button onClick={() => setMode("methods")} style={backLinkStyle}><ChevronLeft size={14} /> All sign-in options</button>
          <div style={{ marginTop: 16 }}>
            <label style={labelStyle}>Email address</label>
            <div style={inputWrapStyle}>
              <Mail size={15} color={GOLD} />
              <input type="email" placeholder="you@example.com" value={email} onChange={(e) => setEmail(e.target.value)} style={inputStyle} />
            </div>
            <label style={labelStyle}>Password</label>
            <div style={inputWrapStyle}>
              <KeyRound size={15} color={GOLD} />
              <input type="password" placeholder="••••••••" value={pw} onChange={(e) => setPw(e.target.value)} style={inputStyle} />
            </div>
            <button
              disabled={!email || !pw}
              onClick={() => finishLogin(email.split("@")[0] || "Guest", "email")}
              style={{ ...primaryBtnStyle, opacity: email && pw ? 1 : 0.45, cursor: email && pw ? "pointer" : "not-allowed" }}
            >
              Sign in <ArrowRight size={15} />
            </button>
            <div style={{ textAlign: "center", marginTop: 14, fontSize: 12, color: GOLD_SOFT, cursor: "pointer" }}>
              Forgot password? · Create an account
            </div>
          </div>
        </>
      )}

      {mode === "phone" && (
        <>
          <button onClick={() => setMode("methods")} style={backLinkStyle}><ChevronLeft size={14} /> All sign-in options</button>
          <div style={{ marginTop: 16 }}>
            <label style={labelStyle}>Phone number</label>
            <div style={inputWrapStyle}>
              <Phone size={15} color={GOLD} />
              <input type="tel" placeholder="+1 555 000 1234" value={phone} onChange={(e) => setPhone(e.target.value)} style={inputStyle} disabled={otpSent} />
            </div>
            {!otpSent ? (
              <button
                disabled={!phone}
                onClick={() => setOtpSent(true)}
                style={{ ...primaryBtnStyle, opacity: phone ? 1 : 0.45, cursor: phone ? "pointer" : "not-allowed" }}
              >
                Send one-time code
              </button>
            ) : (
              <>
                <label style={labelStyle}>Enter 6-digit code sent to {phone}</label>
                <div style={inputWrapStyle}>
                  <ShieldCheck size={15} color={GOLD} />
                  <input placeholder="••••••" value={otp} onChange={(e) => setOtp(e.target.value)} style={{ ...inputStyle, letterSpacing: "0.3em" }} />
                </div>
                <button
                  disabled={otp.length < 4}
                  onClick={() => finishLogin(phone, "phone")}
                  style={{ ...primaryBtnStyle, opacity: otp.length >= 4 ? 1 : 0.45, cursor: otp.length >= 4 ? "pointer" : "not-allowed" }}
                >
                  Verify & sign in
                </button>
              </>
            )}
          </div>
        </>
      )}
    </div>
  );
}

